# TfNSW Open Data Hub API key (register at https://opendata.transport.nsw.gov.au)
TFNSW_API_KEY=

# GCP project that hosts the BigQuery datasets
GCP_PROJECT_ID=

# Path to a service-account JSON key with BigQuery Data Editor + Job User
# on the `raw` dataset. Never commit the actual key file.
GOOGLE_APPLICATION_CREDENTIALS=

# BigQuery dataset names (defaults shown)
BQ_RAW_DATASET=raw
BQ_LOCATION=australia-southeast1
