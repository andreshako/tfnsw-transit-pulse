# TfNSW Open Data Hub API key (register at https://opendata.transport.nsw.gov.au)
TFNSW_API_KEY=

# Sydney Trains GTFS-Realtime trip-updates v2 endpoint. Confirm the exact path
# on your Open Data Hub dashboard after subscribing -- the v1 endpoint this
# project's default guesses at was deprecated 2025-05-27. Leave unset to use
# ingestion/config.py's default and override it once you've confirmed it.
TFNSW_TRIP_UPDATES_URL=

# GCP project that hosts the BigQuery datasets
GCP_PROJECT_ID=

# Path to the tfnsw-ingestion service-account JSON key (BigQuery Data
# Editor + Job User, scoped to the `raw` dataset only). Used by
# ingestion/*.py. Never commit the actual key file.
GOOGLE_APPLICATION_CREDENTIALS=

# Path to the tfnsw-dbt-runner service-account JSON key (Data Viewer on
# `raw`, Data Editor on `staging`/`marts`/`seed`). Used by dbt's `dev`
# profile target -- deliberately a separate identity from ingestion's, so
# a leaked ingestion key can't write to the transformed layers and a
# leaked dbt-runner key can't touch raw ingestion. Never commit the
# actual key file.
DBT_KEYFILE=

# BigQuery dataset names (defaults shown)
BQ_RAW_DATASET=raw
BQ_LOCATION=australia-southeast1
